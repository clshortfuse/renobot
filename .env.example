# Required to start Renobot and register commands. Keep this secret.
DISCORD_TOKEN=

# Required to register the guild's slash commands.
DISCORD_CLIENT_ID=

# Required. Commands are registered only in this server.
DISCORD_GUILD_ID=

# Required. Owner-only commands use this ID; /pin and /summarize have exceptions.
DISCORD_OWNER_USER_ID=

# Keep false until Discord approves Message Content Intent for Renobot.
DISCORD_MESSAGE_CONTENT_INTENT=false

# Optional: include messages authored by other bots. Renobot is always excluded.
REVIEW_INCLUDE_BOTS=false

# Optional: review period in days, from 1 through 30.
REVIEW_LOOKBACK_DAYS=7

# Optional: maximum collected messages across every source, from 1 through 10000.
REVIEW_MAX_MESSAGES=2500

# Optional: trace, debug, info, warn, error, fatal, or silent.
LOG_LEVEL=info

# Optional model connection. On a VPS, localhost refers to the VPS, not your PC.
LLM_BASE_URL=http://localhost:1234/v1/
LLM_PROTOCOL=chat-completions
# Set the model identifier exposed by your server.
LLM_MODEL=
# Optional; local servers normally need no API key.
LLM_API_KEY=
LLM_TIMEOUT_MS=120000
LLM_MAX_OUTPUT_TOKENS=4096

# Optional additional role allowed to invoke /summarize (owner always allowed).
DISCORD_SUMMARIZE_ROLE_ID=

# Optional portal capabilities, checked against current guild membership via Discord.
# The modder role grants access to Ko-fi settings; moderator features are not yet available.
DISCORD_MODDER_ROLE_ID=
DISCORD_MODERATOR_ROLE_ID=

# Set all dashboard values together to enable the HTTPS Discord OAuth dashboard.
DISCORD_CLIENT_SECRET=
PUBLIC_BASE_URL=https://renobot.renodx.com/
# Generate at least 32 random bytes and enter them directly into the host secret file.
SESSION_SECRET=
# Keep the Node.js listener private behind Nginx.
HTTP_HOST=127.0.0.1
HTTP_PORT=3000

# Optional until database-backed portal features are enabled. On the deployed
# host use file:/data/renobot.db (private bind mount, not the read-only image).
# For local development use file:./dev.db (relative to prisma/schema.prisma).
DATABASE_URL=

# Set all three together (and DATABASE_URL) to enable modder Ko-fi settings.
# Generate 32 random bytes, base64-encode them, and keep the key outside the DB.
KOFI_ENCRYPTION_KEY=
# Owner-controlled eligibility floor; the settings form cannot save less.
SUPPORTER_MINIMUM_AMOUNT=
# Single supported currency for the initial Ko-fi integration (e.g. USD).
SUPPORTER_CURRENCY=

# Optional: explicitly enable 35-day renewable membership and Discord role sync.
# Ko-fi test deliveries are treated as real payments; use only when this is acceptable.
DISCORD_SUPPORTER_ROLE_ID=

# Optional: enable the separate owner-reviewed Early Access donation role.
# Requires the Ko-fi database settings; historical imports never grant roles automatically.
DISCORD_EARLY_ACCESS_ROLE_ID=

# Optional exact socket IP of the host Nginx as seen from the container. If
# unset, webhook provenance uses the socket peer and ignores forwarding headers.
KOFI_TRUSTED_PROXY_IP=

# Optional payment email verification. All four values required; never commit credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
